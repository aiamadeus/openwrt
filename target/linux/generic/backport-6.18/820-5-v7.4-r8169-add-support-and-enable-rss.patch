@@ -4124,6 +4280,13 @@ static void rtl_hw_start_8125_common(str
 	    tp->mac_version == RTL_GIGA_MAC_VER_80)
 		RTL_W8(tp, 0xD8, RTL_R8(tp, 0xD8) & ~0x02);
 
