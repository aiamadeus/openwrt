From 3133dbfc69dc2373b10e9e73bc846bf92a48b07e Mon Sep 17 00:00:00 2001
From: deepseek-ai <service@deepseek.com>
Subject: [PATCH] net: dsa: realtek: add RTL8372/RTL8372N DSA driver

Add a DSA driver for the Realtek RTL8372 and RTL8372N switches.  These
chips use a 32-bit register interface on MDIO and a different register
map from the RTL8365MB family, but share the Realtek 8-byte protocol 4
CPU tag (inserted after the source MAC address) and the Realtek DSA
common infrastructure (realtek-mdio and rtl83xx).

The driver supports the two SerDes MACs (ports 3 and 8), the four
RTL8224 2.5G PHY channels (ports 4..7), port isolation, bridge FIDs,
learning, STP, flooding, FDB offload and MTU configuration.

Extend realtek-mdio with the 32-bit MDIO register access protocol and
allow variants to select the register value width used by the common
regmap.

Assisted-by: deepseek-harness:deepseek-v4.1-flash
---

--- a/drivers/net/dsa/realtek/Kconfig
+++ b/drivers/net/dsa/realtek/Kconfig
@@ -36,6 +36,14 @@ config NET_DSA_REALTEK_RTL8365MB
 	help
 	  Select to enable support for Realtek RTL8365MB-VC and RTL8367S.
 
+config NET_DSA_REALTEK_RTL8372
+	tristate "Realtek RTL8372 switch driver"
+	depends on NET_DSA_REALTEK_MDIO
+	select NET_DSA_TAG_RTL8_4
+	help
+	  Select to enable support for the Realtek RTL8372 and RTL8372N
+	  Ethernet switches.
+
 config NET_DSA_REALTEK_RTL8366RB
 	tristate "Realtek RTL8366RB switch driver"
 	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO
--- a/drivers/net/dsa/realtek/Makefile
+++ b/drivers/net/dsa/realtek/Makefile
@@ -15,6 +15,7 @@ rtl8366-objs 				:= rtl8366-core.o rtl83
 ifdef CONFIG_NET_DSA_REALTEK_RTL8366RB_LEDS
 rtl8366-objs 				+= rtl8366rb-leds.o
 endif
+obj-$(CONFIG_NET_DSA_REALTEK_RTL8372) += rtl8372.o
 obj-$(CONFIG_NET_DSA_REALTEK_RTL8365MB) += rtl8365mb.o
 rtl8365mb-objs := rtl8365mb_main.o \
 		  rtl8365mb_table.o \
--- a/drivers/net/dsa/realtek/realtek.h
+++ b/drivers/net/dsa/realtek/realtek.h
@@ -156,6 +156,10 @@ struct realtek_ops {
 	int	(*phy_read)(struct realtek_priv *priv, int phy, int regnum);
 	int	(*phy_write)(struct realtek_priv *priv, int phy, int regnum,
 			     u16 val);
+	int	(*phy_read_c45)(struct realtek_priv *priv, int phy, int devad,
+				int regnum);
+	int	(*phy_write_c45)(struct realtek_priv *priv, int phy, int devad,
+				 int regnum, u16 val);
 };
 
 struct realtek_variant {
@@ -166,6 +170,7 @@ struct realtek_variant {
 	u8 cmd_read;
 	u8 cmd_write;
 	size_t chip_data_sz;
+	u8 val_bits;
 };
 
 /* RTL8366 library helpers */
--- a/drivers/net/dsa/realtek/realtek-mdio.c
+++ b/drivers/net/dsa/realtek/realtek-mdio.c
@@ -19,6 +19,7 @@
  * Copyright (C) 2009-2010 Gabor Juhos <juhosg@openwrt.org>
  */
 
+#include <linux/delay.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/overflow.h>
@@ -101,6 +102,166 @@ out_unlock:
 	return ret;
 }
 
+/* The RTL837x family uses a different command encoding: the switch is
+ * addressed at its MDIO address, register 22 holds the 16-bit switch
+ * register address, registers 23/24 hold the low/high halves of the
+ * 32-bit data word and register 21 is the command register.
+ */
+#define REALTEK_MDIO32_CTRL_REG		21
+#define REALTEK_MDIO32_ADDR_REG		22
+#define REALTEK_MDIO32_DATA_LOW_REG	23
+#define REALTEK_MDIO32_DATA_HIGH_REG	24
+#define REALTEK_MDIO32_BUSY		BIT(2)
+#define REALTEK_MDIO32_READ_CMD		0x1b
+#define REALTEK_MDIO32_WRITE_CMD	0x19
+
+static int realtek_mdio32_wait(struct mii_bus *bus, int addr)
+{
+	int i, val;
+
+	for (i = 0; i < 100; i++) {
+		val = bus->read(bus, addr, REALTEK_MDIO32_CTRL_REG);
+		if (val < 0)
+			return val;
+		if (!(val & REALTEK_MDIO32_BUSY))
+			return 0;
+		usleep_range(10, 20);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int realtek_mdio32_write_nolock(struct realtek_priv *priv, u32 reg,
+				       u32 val)
+{
+	struct mii_bus *bus = priv->bus;
+	int ret;
+
+	ret = realtek_mdio32_wait(bus, priv->mdio_addr);
+	if (ret)
+		return ret;
+
+	ret = bus->write(bus, priv->mdio_addr, REALTEK_MDIO32_ADDR_REG,
+			 reg & GENMASK(15, 0));
+	if (ret)
+		return ret;
+
+	ret = bus->write(bus, priv->mdio_addr, REALTEK_MDIO32_DATA_LOW_REG,
+			 val & GENMASK(15, 0));
+	if (ret)
+		return ret;
+
+	ret = bus->write(bus, priv->mdio_addr, REALTEK_MDIO32_DATA_HIGH_REG,
+			 (val >> 16) & GENMASK(15, 0));
+	if (ret)
+		return ret;
+
+	ret = bus->write(bus, priv->mdio_addr, REALTEK_MDIO32_CTRL_REG,
+			 REALTEK_MDIO32_WRITE_CMD);
+	if (ret)
+		return ret;
+
+	return realtek_mdio32_wait(bus, priv->mdio_addr);
+}
+
+static int realtek_mdio32_write(void *ctx, u32 reg, u32 val)
+{
+	struct realtek_priv *priv = ctx;
+	struct mii_bus *bus = priv->bus;
+	int ret;
+
+	mutex_lock(&bus->mdio_lock);
+	ret = realtek_mdio32_write_nolock(priv, reg, val);
+	mutex_unlock(&bus->mdio_lock);
+
+	return ret;
+}
+
+static int realtek_mdio32_read(void *ctx, u32 reg, u32 *val)
+{
+	struct realtek_priv *priv = ctx;
+	struct mii_bus *bus = priv->bus;
+	int ret, low, high;
+
+	mutex_lock(&bus->mdio_lock);
+
+	ret = realtek_mdio32_wait(bus, priv->mdio_addr);
+	if (ret)
+		goto out_unlock;
+
+	ret = bus->write(bus, priv->mdio_addr, REALTEK_MDIO32_ADDR_REG,
+			 reg & GENMASK(15, 0));
+	if (ret)
+		goto out_unlock;
+
+	ret = bus->write(bus, priv->mdio_addr, REALTEK_MDIO32_CTRL_REG,
+			 REALTEK_MDIO32_READ_CMD);
+	if (ret)
+		goto out_unlock;
+
+	ret = realtek_mdio32_wait(bus, priv->mdio_addr);
+	if (ret)
+		goto out_unlock;
+
+	low = bus->read(bus, priv->mdio_addr, REALTEK_MDIO32_DATA_LOW_REG);
+	if (low < 0) {
+		ret = low;
+		goto out_unlock;
+	}
+
+	high = bus->read(bus, priv->mdio_addr, REALTEK_MDIO32_DATA_HIGH_REG);
+	if (high < 0) {
+		ret = high;
+		goto out_unlock;
+	}
+
+	*val = (low & GENMASK(15, 0)) | ((high & GENMASK(15, 0)) << 16);
+	ret = 0;
+
+out_unlock:
+	mutex_unlock(&bus->mdio_lock);
+	return ret;
+}
+
+static const struct realtek_interface_info realtek_mdio32_info = {
+	.reg_read = realtek_mdio32_read,
+	.reg_write = realtek_mdio32_write,
+};
+
+/**
+ * realtek_mdio_probe_32() - Probe a 32-bit MDIO-connected switch
+ * @mdiodev: mdio_device to probe on.
+ *
+ * Same as realtek_mdio_probe(), but for switches using the 32-bit
+ * register access protocol (RTL837x family).
+ *
+ * Context: Can sleep.
+ * Return: 0 on success, a negative error on failure.
+ */
+int realtek_mdio_probe_32(struct mdio_device *mdiodev)
+{
+	struct device *dev = &mdiodev->dev;
+	struct realtek_priv *priv;
+	int ret;
+
+	priv = rtl83xx_probe(dev, &realtek_mdio32_info);
+	if (IS_ERR(priv))
+		return PTR_ERR(priv);
+
+	priv->bus = mdiodev->bus;
+	priv->mdio_addr = mdiodev->addr;
+	priv->write_reg_noack = realtek_mdio32_write;
+
+	ret = rtl83xx_register_switch(priv);
+	if (ret) {
+		rtl83xx_remove(priv);
+		return ret;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_NS_GPL(realtek_mdio_probe_32, "REALTEK_DSA");
+
 static const struct realtek_interface_info realtek_mdio_info = {
 	.reg_read = realtek_mdio_read,
 	.reg_write = realtek_mdio_write,
--- a/drivers/net/dsa/realtek/realtek-mdio.h
+++ b/drivers/net/dsa/realtek/realtek-mdio.h
@@ -16,6 +16,7 @@ static inline void realtek_mdio_driver_u
 }
 
 int realtek_mdio_probe(struct mdio_device *mdiodev);
+int realtek_mdio_probe_32(struct mdio_device *mdiodev);
 void realtek_mdio_remove(struct mdio_device *mdiodev);
 void realtek_mdio_shutdown(struct mdio_device *mdiodev);
 
@@ -34,6 +35,11 @@ static inline int realtek_mdio_probe(str
 {
 	return -ENOENT;
 }
+
+static inline int realtek_mdio_probe_32(struct mdio_device *mdiodev)
+{
+	return -ENOENT;
+}
 
 static inline void realtek_mdio_remove(struct mdio_device *mdiodev)
 {
--- a/drivers/net/dsa/realtek/rtl83xx.c
+++ b/drivers/net/dsa/realtek/rtl83xx.c
@@ -61,6 +61,28 @@ static int rtl83xx_user_mdio_write(struc
 	return priv->ops->phy_write(priv, addr, regnum, val);
 }
 
+static int rtl83xx_user_mdio_read_c45(struct mii_bus *bus, int addr,
+				      int devad, int regnum)
+{
+	struct realtek_priv *priv = bus->priv;
+
+	if (!priv->ops->phy_read_c45)
+		return -EOPNOTSUPP;
+
+	return priv->ops->phy_read_c45(priv, addr, devad, regnum);
+}
+
+static int rtl83xx_user_mdio_write_c45(struct mii_bus *bus, int addr,
+				       int devad, int regnum, u16 val)
+{
+	struct realtek_priv *priv = bus->priv;
+
+	if (!priv->ops->phy_write_c45)
+		return -EOPNOTSUPP;
+
+	return priv->ops->phy_write_c45(priv, addr, devad, regnum, val);
+}
+
 /**
  * rtl83xx_setup_user_mdio() - register the user mii bus driver
  * @ds: DSA switch associated with this user_mii_bus
@@ -94,6 +116,8 @@ int rtl83xx_setup_user_mdio(struct dsa_s
 	bus->name = "Realtek user MII";
 	bus->read = rtl83xx_user_mdio_read;
 	bus->write = rtl83xx_user_mdio_write;
+	bus->read_c45 = rtl83xx_user_mdio_read_c45;
+	bus->write_c45 = rtl83xx_user_mdio_write_c45;
 	snprintf(bus->id, MII_BUS_ID_SIZE, "%s:user_mii", dev_name(priv->dev));
 	bus->parent = priv->dev;
 
@@ -151,6 +175,9 @@ rtl83xx_probe(struct device *dev,
 	if (!var)
 		return ERR_PTR(-EINVAL);
 
+	if (var->val_bits)
+		rc.val_bits = var->val_bits;
+
 	priv = devm_kzalloc(dev, size_add(sizeof(*priv), var->chip_data_sz),
 			    GFP_KERNEL);
 	if (!priv)
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8372.c
@@ -0,0 +1,1810 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * DSA driver for the Realtek RTL8372 and RTL8372N Ethernet switches
+ *
+ * The RTL837x family is a different generation than the RTL8365MB family
+ * supported by rtl8365mb.c.  It uses a 32-bit register interface on MDIO
+ * (address 29, registers 21..24) and a different register map, but the
+ * external CPU tag is the same Realtek 8-byte protocol 4 tag used by the
+ * RTL8365MB (DSA_TAG_PROTO_RTL8_4).
+ *
+ * The RTL8372 has two SerDes MACs (ports 3 and 8) and, in the RTL8372N
+ * package, four 2.5G channels provided by an RTL8224 quad PHY (ports 4..7).
+ * The internal PHYs are accessed through the switch's SMI indirect PHY
+ * access registers and are exposed to Linux as the switch's user MDIO bus.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/etherdevice.h>
+#include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
+#include <linux/module.h>
+#include <linux/of_mdio.h>
+#include <linux/of_net.h>
+#include <linux/phylink.h>
+#include <linux/regmap.h>
+
+#include "realtek.h"
+#include "realtek-mdio.h"
+#include "rtl83xx.h"
+
+#define RTL8372_NUM_PORTS		9
+#define RTL8372_PORT_MASK		GENMASK(9, 0)
+
+/* First and last port with a MAC (ports 0..2 are not bonded out). */
+#define RTL8372_FIRST_MAC_PORT		3
+#define RTL8372_LAST_MAC_PORT		8
+
+/* SerDes port -> SerDes index mapping. */
+#define RTL8372_SDS_PORT0		3
+#define RTL8372_SDS_PORT1		8
+
+/* Chip identification */
+#define RTL8372_CHIP_ID_REG		0x0004
+#define RTL8372_CHIP_ID_MASK		GENMASK(31, 8)
+#define RTL8372_CHIP_ID_8372		0x837200
+#define RTL8372_CHIP_ID_8372N		0x837270
+
+#define RTL8372_CHIP_INFO_REG		0x000c
+#define   RTL8372_CHIP_INFO_EN_MASK	GENMASK(19, 16)
+#define   RTL8372_CHIP_INFO_EN		0xa
+#define   RTL8372_CHIP_INFO_RL_VID_MASK	GENMASK(31, 28)
+
+/* SMI (MDC/MDIO) configuration */
+#define RTL8372_SMI_GLB_CTRL_REG	0x632c
+#define   RTL8372_SMI_POLLING_MASK	GENMASK(20, 12)
+#define RTL8372_SMI_MAC_TYPE_CTRL_REG	0x6330
+#define   RTL8372_SMI_MAC_PORT3_TYPE	GENMASK(7, 6)
+#define   RTL8372_SMI_MAC_PORT8_TYPE	GENMASK(17, 16)
+#define RTL8372_SMI_PORT_POLLING_SEL_REG 0x6334
+#define RTL8372_SMI_CTRL_REG		0x6454
+#define   RTL8372_SMI_MDC_EN		GENMASK(14, 12)
+
+/* Indirect PHY access through SMI */
+#define RTL8372_SMI_PHY_CTRL0_REG	0x6438
+#define   RTL8372_SMI_PHY_CTRL0_MASK	GENMASK(8, 0)
+#define RTL8372_SMI_PHY_CTRL1_REG	0x643c
+#define   RTL8372_SMI_PHY_CMD		BIT(0)
+#define   RTL8372_SMI_PHY_TYPE		BIT(1)
+#define   RTL8372_SMI_PHY_RWOP		BIT(2)
+#define   RTL8372_SMI_PHY_REG		GENMASK(18, 3)
+#define   RTL8372_SMI_PHY_DEVAD		GENMASK(23, 19)
+#define   RTL8372_SMI_PHY_FAIL		GENMASK(26, 24)
+#define RTL8372_SMI_PHY_CTRL2_REG	0x6440
+#define   RTL8372_SMI_PHY_RDATA		GENMASK(15, 0)
+#define RTL8372_SMI_PHY_CTRL3_REG	0x6444
+#define   RTL8372_SMI_PHY_WDATA		GENMASK(15, 0)
+
+/* SerDes registers (indirect access) */
+#define RTL8372_SDS_MODE_SEL_REG	0x7b20
+#define   RTL8372_SDS0_MODE_SEL		GENMASK(4, 0)
+#define   RTL8372_SDS0_USX_SUB_MODE	GENMASK(14, 10)
+#define   RTL8372_SDS1_MODE_SEL		GENMASK(9, 5)
+#define   RTL8372_SDS1_USX_SUB_MODE	GENMASK(20, 16)
+#define   RTL8372_SDS_CFG_MAC3_8221B	BIT(21)
+#define   RTL8372_SDS_CFG_MAC8_8221B	BIT(22)
+
+#define RTL8372_SDS_INDACS_CMD_REG	0x03f8
+#define   RTL8372_SDS_CMD		BIT(15)
+#define   RTL8372_SDS_RWOP		BIT(14)
+#define   RTL8372_SDS_REGAD		GENMASK(11, 7)
+#define   RTL8372_SDS_PAGE		GENMASK(6, 1)
+#define   RTL8372_SDS_INDEX		BIT(0)
+#define RTL8372_SDS_INDACS_RD_REG	0x03fc
+#define RTL8372_SDS_INDACS_WD_REG	0x0400
+
+#define RTL8372_SDS_REG_MODE		0x00
+#define RTL8372_SDS_REG_RESET		0x00
+#define RTL8372_SDS_PAGE_RESET		0x20
+#define RTL8372_SDS_PAGE_MISC		0x1f
+
+/* CPU tag configuration */
+#define RTL8372_CPU_TAG_TPID_REG	0x6038
+#define RTL8372_CPU_TAG_AWARE_REG	0x603c
+#define   RTL8372_CPU_TAG_AWARE_MASK	GENMASK(9, 0)
+#define RTL8372_EXT_CPU_CTRL_REG	0x6724
+#define   RTL8372_EXT_CPU_PORT		GENMASK(3, 0)
+#define RTL8372_CPU_TAG_CTRL_REG	0x6720
+#define   RTL8372_INT_CPUTAG_EN		BIT(0)
+#define   RTL8372_EXT_CPUTAG_EN		BIT(1)
+#define   RTL8372_INT_CPUTAG_INSERT	GENMASK(9, 8)
+#define   RTL8372_EXT_CPUTAG_INSERT	GENMASK(11, 10)
+
+enum rtl8372_cpu_insert {
+	RTL8372_CPU_INSERT_TO_ALL = 0,
+	RTL8372_CPU_INSERT_TO_TRAPPING = 1,
+	RTL8372_CPU_INSERT_TO_NONE = 2,
+};
+
+/* Global MAC/L2 configuration */
+#define RTL8372_MAC_L2_GLOBAL_CTRL0_REG	0x5fd4
+#define   RTL8372_FWD_INVLD_MAC_CTRL_EN	BIT(20)
+#define   RTL8372_FWD_UNKN_OPCODE_EN	BIT(19)
+#define RTL8372_MAC_L2_PORT_CTRL_REG(_port) \
+	(0x1238 + ((_port) << 8))
+#define   RTL8372_PORT_RX_EN		BIT(0)
+#define   RTL8372_PORT_TX_EN		BIT(1)
+#define   RTL8372_PORT_RX_CHK_CRC_EN	BIT(4)
+#define   RTL8372_PORT_CLOCK_SWITCH	BIT(8)
+#define RTL8372_RS_LAYER_CONFIG_REG	0x0b7c
+#define   RTL8372_RS_LINK_FAULT_INDI_OFF BIT(5)
+#define RTL8372_DW8051_CFG_REG		0x6040
+#define   RTL8372_DW8051_READY		BIT(0)
+#define RTL8372_FC_PORT_ACT_CTRL_REG(_port) \
+	(0x7124 + ((_port) << 2))
+
+/* Per-port configuration */
+#define RTL8372_MAC_FORCE_MODE_REG(_port) \
+	(0x6344 + ((_port) << 2))
+#define   RTL8372_MAC_FORCE_EN		BIT(0)
+#define   RTL8372_MAC_FORCE_LINK_EN	BIT(1)
+#define   RTL8372_MAC_FORCE_DUPLEX	BIT(2)
+#define   RTL8372_MAC_FORCE_SPEED	GENMASK(6, 3)
+#define   RTL8372_MAC_FORCE_TXPAUSE	BIT(7)
+#define   RTL8372_MAC_FORCE_RXPAUSE	BIT(8)
+#define   RTL8372_MAC_FORCE_MEDIA	BIT(10)
+
+#define RTL8372_PORT_ISOLATION_REG(_port) \
+	(0x50c0 + ((_port) << 2))
+#define   RTL8372_PORT_ISOLATION_MASK	GENMASK(9, 0)
+#define RTL8372_MSTP_STATE_REG(_msti) \
+	(0x5310 + ((_msti) << 2))
+#define   RTL8372_MSTP_STATE(_port)	GENMASK(((_port) * 2) + 1, \
+					       (_port) * 2)
+
+/* Per-port FID (used as the bridge EFID) */
+#define RTL8372_PORT_BASED_FID_EN_REG	0x4e38
+#define RTL8372_PORT_BASED_FID_REG(_port) \
+	(0x4e3c + (((_port) >> 3) << 2))
+#define   RTL8372_PORT_BASED_FID(_port)	GENMASK((((_port) & 7) * 4) + 3, \
+					       (((_port) & 7) * 4))
+
+/* Learning and flooding */
+#define RTL8372_L2_LEARN_LIMIT_REG(_port) \
+	(0x5384 + ((_port) << 2))
+#define   RTL8372_MAX_LEARN_LIMIT	4160
+#define RTL8372_L2_UNKN_UC_FLOOD_REG	0x5360
+#define RTL8372_L2_UNKN_MC_FLOOD_REG	0x5364
+#define RTL8372_L2_BC_FLOOD_REG		0x5370
+#define   RTL8372_FLOOD_MASK		GENMASK(9, 0)
+
+/* Maximum frame length */
+#define RTL8372_MAC_L2_PORT_MAX_LEN_REG(_port) \
+	(0x1250 + ((_port) << 8))
+#define   RTL8372_MAX_LEN_10M_100M	GENMASK(13, 0)
+#define   RTL8372_MAX_LEN_1G_10G		GENMASK(27, 14)
+#define RTL8372_MAX_FRAME_SIZE		0x3fff
+
+/* L2 table access through the indirect table access (ITA) block */
+#define RTL8372_ITA_CTRL0_REG		0x5cac
+#define   RTL8372_ITA_EXECUTE		BIT(0)
+#define   RTL8372_ITA_ACTION		BIT(1)
+#define   RTL8372_ITA_TBL_TYPE		GENMASK(10, 8)
+#define   RTL8372_ITA_TBL_ADDR		GENMASK(28, 16)
+#define   RTL8372_ITA_TBL_L2		4
+#define RTL8372_ITA_L2_CTRL_REG		0x5cb0
+#define   RTL8372_ITA_L2_ADDR		GENMASK(11, 0)
+#define   RTL8372_ITA_L2_ACT_STS	BIT(12)
+#define   RTL8372_ITA_L2_ENTRY_CLR	BIT(18)
+#define   RTL8372_ITA_L2_PORT		GENMASK(22, 19)
+#define   RTL8372_ITA_L2_READ_MTHD	GENMASK(17, 14)
+#define RTL8372_ITA_WRITE_DATA_REG(_i)	(0x5cb8 + ((_i) << 2))
+#define RTL8372_ITA_READ_DATA_REG(_i)	(0x5ccc + ((_i) << 2))
+
+enum rtl8372_l2_read_method {
+	RTL8372_L2_READ_MAC = 0,
+	RTL8372_L2_READ_NEXT_L2UC = 3,
+	RTL8372_L2_READ_NEXT_L2UCSPA = 7,
+};
+
+/* L2 flush */
+#define RTL8372_L2_FLUSH_CMD_REG	0x53d4
+#define   RTL8372_L2_FLUSH_PMSK		GENMASK(9, 0)
+#define   RTL8372_L2_FLUSH_ACT		BIT(16)
+#define   RTL8372_L2_FLUSH_BUSY		BIT(17)
+#define RTL8372_L2_FLUSH_MODE_REG	0x53dc
+#define   RTL8372_L2_FLUSH_MODE		GENMASK(1, 0)
+#define   RTL8372_L2_FLUSH_TYPE		BIT(2)
+#define RTL8372_L2_FLUSH_XID_REG	0x53e0
+#define   RTL8372_L2_FLUSH_FID		GENMASK(19, 16)
+#define   RTL8372_L2_FLUSH_VID		GENMASK(11, 0)
+
+enum rtl8372_flush_mode {
+	RTL8372_FLUSH_BY_PORT = 0,
+	RTL8372_FLUSH_BY_VID = 1,
+	RTL8372_FLUSH_BY_FID = 2,
+};
