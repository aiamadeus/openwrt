+	.mac_config = rtl8372_phylink_mac_config,
+	.mac_link_up = rtl8372_phylink_mac_link_up,
+	.mac_link_down = rtl8372_phylink_mac_link_down,
+};
+
+static const struct dsa_switch_ops rtl8372_switch_ops = {
+	.get_tag_protocol = rtl8372_get_tag_protocol,
+	.change_tag_protocol = rtl8372_change_tag_protocol,
+	.setup = rtl8372_setup,
+	.teardown = rtl8372_teardown,
+	.phylink_get_caps = rtl8372_phylink_get_caps,
+	.port_bridge_join = rtl83xx_port_bridge_join,
+	.port_bridge_leave = rtl83xx_port_bridge_leave,
+	.port_pre_bridge_flags = rtl8372_port_pre_bridge_flags,
+	.port_bridge_flags = rtl83xx_port_bridge_flags,
+	.port_stp_state_set = rtl8372_port_stp_state_set,
+	.port_fast_age = rtl83xx_port_fast_age,
+	.port_fdb_add = rtl83xx_port_fdb_add,
+	.port_fdb_del = rtl83xx_port_fdb_del,
+	.port_fdb_dump = rtl83xx_port_fdb_dump,
+	.port_change_mtu = rtl8372_port_change_mtu,
+	.port_max_mtu = rtl8372_port_max_mtu,
+};
+
+static const struct realtek_ops rtl8372_ops = {
+	.detect = rtl8372_detect,
+	.port_add_isolation = rtl8372_port_add_isolation,
+	.port_remove_isolation = rtl8372_port_remove_isolation,
+	.port_set_efid = rtl8372_port_set_efid,
+	.port_set_learning = rtl8372_port_set_learning,
+	.port_set_ucast_flood = rtl8372_port_set_ucast_flood,
+	.port_set_mcast_flood = rtl8372_port_set_mcast_flood,
+	.port_set_bcast_flood = rtl8372_port_set_bcast_flood,
+	.l2_add_uc = rtl8372_l2_add_uc,
+	.l2_del_uc = rtl8372_l2_del_uc,
+	.l2_get_next_uc = rtl8372_l2_get_next_uc,
+	.l2_flush = rtl8372_l2_flush,
+	.phy_read = rtl8372_phy_read,
+	.phy_write = rtl8372_phy_write,
+	.phy_read_c45 = rtl8372_phy_read_c45,
+	.phy_write_c45 = rtl8372_phy_write_c45,
+};
+
+static const struct realtek_variant rtl8372_variant = {
+	.ds_ops = &rtl8372_switch_ops,
+	.ops = &rtl8372_ops,
+	.phylink_mac_ops = &rtl8372_phylink_mac_ops,
+	.clk_delay = 10,
+	.chip_data_sz = sizeof(struct rtl8372),
