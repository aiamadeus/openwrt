+static int rtl8372_sds_wait(struct realtek_priv *priv)
+{
+	u32 val;
+
+	return regmap_read_poll_timeout(priv->map, RTL8372_SDS_INDACS_CMD_REG,
+					val, !(val & RTL8372_SDS_CMD),
+					10, 100000);
+}
+
+static int rtl8372_sds_write(struct realtek_priv *priv, int sds, int page,
+			     int reg, u16 data)
+{
+	u32 cmd;
+	int ret;
+
+	ret = rtl8372_sds_wait(priv);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->map, RTL8372_SDS_INDACS_WD_REG, data);
+	if (ret)
+		return ret;
+
+	cmd = FIELD_PREP(RTL8372_SDS_INDEX, sds) |
+	      FIELD_PREP(RTL8372_SDS_PAGE, page) |
+	      FIELD_PREP(RTL8372_SDS_REGAD, reg) |
+	      RTL8372_SDS_RWOP | RTL8372_SDS_CMD;
+
+	ret = regmap_write(priv->map, RTL8372_SDS_INDACS_CMD_REG, cmd);
+	if (ret)
+		return ret;
+
+	return rtl8372_sds_wait(priv);
+}
+
+static int rtl8372_sds_read(struct realtek_priv *priv, int sds, int page,
+			    int reg, u16 *data)
+{
+	u32 cmd, val;
+	int ret;
+
+	ret = rtl8372_sds_wait(priv);
+	if (ret)
+		return ret;
+
+	cmd = FIELD_PREP(RTL8372_SDS_INDEX, sds) |
+	      FIELD_PREP(RTL8372_SDS_PAGE, page) |
+	      FIELD_PREP(RTL8372_SDS_REGAD, reg) |
+	      RTL8372_SDS_CMD;
+
+	ret = regmap_write(priv->map, RTL8372_SDS_INDACS_CMD_REG, cmd);
+	if (ret)
+		return ret;
+
+	ret = rtl8372_sds_wait(priv);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->map, RTL8372_SDS_INDACS_RD_REG, &val);
+	if (ret)
+		return ret;
+
+	*data = val & GENMASK(15, 0);
+
+	return 0;
+}
+
+static int rtl8372_sds_update_bits(struct realtek_priv *priv, int sds,
+				   int page, int reg, u16 mask, u16 val)
+{
+	u16 tmp;
+	int ret;
+
+	ret = rtl8372_sds_read(priv, sds, page, reg, &tmp);
+	if (ret)
+		return ret;
+
+	tmp &= ~mask;
+	tmp |= val & mask;
+
+	return rtl8372_sds_write(priv, sds, page, reg, tmp);
+}
+
+static void rtl8372_sds_reset_flow(struct realtek_priv *priv, int sds)
+{
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(5, 4), 0x3);
+	usleep_range(10, 20);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(5, 4), 0x1);
+	usleep_range(100, 200);
+
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(7, 6), 0x1);
+	usleep_range(10, 20);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(7, 6), 0x3);
+	usleep_range(100, 200);
+
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(11, 10), 0x3);
+	usleep_range(10, 20);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(11, 10), 0x1);
+	usleep_range(100, 200);
+}
+
+static void rtl8372_sds_reset_flow_full(struct realtek_priv *priv, int sds)
+{
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(11, 10), 0x1);
+	usleep_range(10, 20);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(11, 10), 0x3);
+	usleep_range(100, 200);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(11, 10), 0x0);
+	usleep_range(10, 20);
+
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(7, 6), 0x3);
+	usleep_range(10, 20);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(7, 6), 0x1);
+	usleep_range(100, 200);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(7, 6), 0x0);
+	usleep_range(10, 20);
+
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(5, 4), 0x1);
+	usleep_range(10, 20);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(5, 4), 0x3);
+	usleep_range(100, 200);
+	rtl8372_sds_update_bits(priv, sds, RTL8372_SDS_PAGE_RESET,
+				RTL8372_SDS_REG_RESET, GENMASK(5, 4), 0x0);
+	usleep_range(100, 200);
+}
+
+static int rtl8372_sds_patch_table(struct realtek_priv *priv, int sds,
+				   const struct rtl8372_sds_patch *tbl,
+				   size_t len)
+{
+	int ret;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		ret = rtl8372_sds_write(priv, sds, tbl[i].page, tbl[i].reg,
+					tbl[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int rtl8372_sds_mode_set(struct realtek_priv *priv, int sds, int mode)
+{
+	struct rtl8372 *mb = priv->chip_data;
+	const struct rtl8372_sds_patch *an, *dig = rtl8372_sds_dig_mac;
+	size_t an_len, dig_len = ARRAY_SIZE(rtl8372_sds_dig_mac);
+	bool chipa = mb->chip_info->chip_id == RTL8372_CHIP_ID_8372 &&
+		     mb->chip_ver == 0;
+	u32 sel, mask;
+	int ret;
+
+	if (mb->sds_mode[sds] == mode)
+		return 0;
+
+	/* The RTL8372 can alternatively drive the SerDes from
+	 * an RTL8221B PHY. We only support the MAC mode.
+	 */
+	regmap_update_bits(priv->map, RTL8372_SDS_MODE_SEL_REG,
+			   RTL8372_SDS_CFG_MAC3_8221B |
+				   RTL8372_SDS_CFG_MAC8_8221B, 0);
+	usleep_range(1000, 2000);
+
+	/* Quiesce the SerDes before changing its mode. */
+	rtl8372_sds_reset_flow(priv, sds);
+
+	switch (mode) {
+	case RTL8372_SERDES_10GR:
+	case RTL8372_SERDES_10GUSXG:
+	case RTL8372_SERDES_10GQXG:
+		an = chipa ? rtl8372_sds_10g_chipa : rtl8372_sds_10g_chipb;
+		an_len = chipa ? ARRAY_SIZE(rtl8372_sds_10g_chipa) :
+				 ARRAY_SIZE(rtl8372_sds_10g_chipb);
+		break;
+	case RTL8372_SERDES_HSG:
+	case RTL8372_SERDES_2500BASEX:
+		an = chipa ? rtl8372_sds_2p5g_chipa : rtl8372_sds_2p5g_chipb;
+		an_len = chipa ? ARRAY_SIZE(rtl8372_sds_2p5g_chipa) :
+				 ARRAY_SIZE(rtl8372_sds_2p5g_chipb);
+		break;
+	case RTL8372_SERDES_SG:
+	case RTL8372_SERDES_1000BASEX:
+		an = chipa ? rtl8372_sds_1g_chipa : rtl8372_sds_1g_chipb;
+		an_len = chipa ? ARRAY_SIZE(rtl8372_sds_1g_chipa) :
+				 ARRAY_SIZE(rtl8372_sds_1g_chipb);
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	if (sds == 0) {
+		mask = RTL8372_SDS0_MODE_SEL | RTL8372_SDS0_USX_SUB_MODE;
+		sel = FIELD_PREP(RTL8372_SDS0_MODE_SEL, mode);
+		if (mode == RTL8372_SERDES_10GQXG)
+			sel |= FIELD_PREP(RTL8372_SDS0_USX_SUB_MODE, 2);
+	} else {
+		mask = RTL8372_SDS1_MODE_SEL | RTL8372_SDS1_USX_SUB_MODE;
+		sel = FIELD_PREP(RTL8372_SDS1_MODE_SEL, mode);
+		if (mode == RTL8372_SERDES_10GQXG)
+			sel |= FIELD_PREP(RTL8372_SDS1_USX_SUB_MODE, 2);
+	}
+
+	ret = regmap_update_bits(priv->map, RTL8372_SDS_MODE_SEL_REG, mask,
+				 sel);
+	if (ret)
+		return ret;
+
+	ret = rtl8372_sds_patch_table(priv, sds, an, an_len);
+	if (ret)
+		return ret;
+
+	ret = rtl8372_sds_patch_table(priv, sds, dig, dig_len);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 2000);
+	rtl8372_sds_reset_flow_full(priv, sds);
+
+	ret = rtl8372_sds_write(priv, sds, RTL8372_SDS_PAGE_MISC, 0x00,
+				0x000b);
+	if (ret)
+		return ret;
+	usleep_range(100, 200);
+
+	ret = rtl8372_sds_write(priv, sds, RTL8372_SDS_PAGE_MISC, 0x00, 0x0000);
+	if (ret)
+		return ret;
+	usleep_range(100, 200);
+
+	mb->sds_mode[sds] = mode;
+
+	return 0;
+}
+
+static int rtl8372_phy_wait(struct realtek_priv *priv, u32 cmd)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_write(priv->map, RTL8372_SMI_PHY_CTRL1_REG, cmd);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(priv->map, RTL8372_SMI_PHY_CTRL1_REG,
+				       val, !(val & RTL8372_SMI_PHY_CMD),
+				       10, 100000);
+	if (ret)
+		return ret;
+
+	if (val & RTL8372_SMI_PHY_FAIL)
+		return -EIO;
+
+	return 0;
+}
+
+static int rtl8372_phy_read_raw(struct realtek_priv *priv, int phy, u8 devad,
+				u16 reg, u16 *data)
+{
+	u32 cmd, val;
+	int ret;
+
+	/* The SMI PHY read command addresses a single PHY by number,
+	 * not by bitmask (unlike the write command).
+	 */
+	ret = regmap_write(priv->map, RTL8372_SMI_PHY_CTRL3_REG, phy);
+	if (ret)
+		return ret;
+
+	cmd = FIELD_PREP(RTL8372_SMI_PHY_DEVAD, devad) |
+	      FIELD_PREP(RTL8372_SMI_PHY_REG, reg) |
+	      RTL8372_SMI_PHY_CMD | RTL8372_SMI_PHY_TYPE;
+	ret = rtl8372_phy_wait(priv, cmd);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->map, RTL8372_SMI_PHY_CTRL2_REG, &val);
+	if (ret)
+		return ret;
+
+	*data = FIELD_GET(RTL8372_SMI_PHY_RDATA, val);
+
+	return 0;
+}
+
+static int rtl8372_phy_write_raw(struct realtek_priv *priv, u32 phy_mask,
+				 u8 devad, u16 reg, u16 data)
+{
+	u32 cmd;
+	int ret;
+
+	ret = regmap_write(priv->map, RTL8372_SMI_PHY_CTRL0_REG, phy_mask);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->map, RTL8372_SMI_PHY_CTRL3_REG, data);
+	if (ret)
+		return ret;
+
+	cmd = FIELD_PREP(RTL8372_SMI_PHY_DEVAD, devad) |
+	      FIELD_PREP(RTL8372_SMI_PHY_REG, reg) |
+	      RTL8372_SMI_PHY_CMD | RTL8372_SMI_PHY_RWOP |
+	      RTL8372_SMI_PHY_TYPE;
+
+	return rtl8372_phy_wait(priv, cmd);
+}
+
+static int rtl8372_phy_read(struct realtek_priv *priv, int phy, int regnum)
+{
+	u16 data;
+	int ret;
+
+	if (phy < 0 || phy >= RTL8372_NUM_PORTS)
+		return -EIO;
+
+	ret = rtl8372_phy_read_raw(priv, phy, 0, regnum & GENMASK(15, 0),
+				   &data);
+	if (ret)
+		return ret;
+
+	return data;
+}
+
+static int rtl8372_phy_write(struct realtek_priv *priv, int phy, int regnum,
+			     u16 val)
+{
+	if (phy < 0 || phy >= RTL8372_NUM_PORTS)
+		return -EIO;
+
+	return rtl8372_phy_write_raw(priv, BIT(phy), 0,
+				     regnum & GENMASK(15, 0), val);
+}
+
+static int rtl8372_phy_read_c45(struct realtek_priv *priv, int phy,
+				int devad, int regnum)
+{
+	u16 data;
+	int ret;
+
+	if (phy < 0 || phy >= RTL8372_NUM_PORTS)
+		return -EIO;
+
+	ret = rtl8372_phy_read_raw(priv, phy, devad, regnum, &data);
+	if (ret)
+		return ret;
+
+	return data;
+}
+
+static int rtl8372_phy_write_c45(struct realtek_priv *priv, int phy,
+				 int devad, int regnum, u16 val)
+{
+	if (phy < 0 || phy >= RTL8372_NUM_PORTS)
+		return -EIO;
+
+	return rtl8372_phy_write_raw(priv, BIT(phy), devad, regnum, val);
+}
+
+static int rtl8372_read_chip_version(struct realtek_priv *priv)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_update_bits(priv->map, RTL8372_CHIP_INFO_REG,
+				 RTL8372_CHIP_INFO_EN_MASK,
+				 FIELD_PREP(RTL8372_CHIP_INFO_EN_MASK,
+					    RTL8372_CHIP_INFO_EN));
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->map, RTL8372_CHIP_INFO_REG, &val);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8372_CHIP_INFO_REG,
+				 RTL8372_CHIP_INFO_EN_MASK, 0);
+	if (ret)
+		return ret;
+
+	return FIELD_GET(RTL8372_CHIP_INFO_RL_VID_MASK, val);
+}
+
+static int rtl8372_switch_init(struct realtek_priv *priv)
+{
+	struct rtl8372 *mb = priv->chip_data;
+	int ret, port;
+
+	/* Set up the MDC/MDIO pads and let ports 4..7 poll their internal
+	 * PHY (the RTL8224 channels).
+	 */
+	ret = regmap_update_bits(priv->map, RTL8372_SMI_PORT_POLLING_SEL_REG,
+				 GENMASK(7, 4), 0x00f0);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8372_SMI_CTRL_REG,
+				 RTL8372_SMI_MDC_EN,
+				 FIELD_PREP(RTL8372_SMI_MDC_EN, 7));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8372_SMI_MAC_TYPE_CTRL_REG,
+				 RTL8372_SMI_MAC_PORT3_TYPE |
+					 RTL8372_SMI_MAC_PORT8_TYPE, 0);
+	if (ret)
+		return ret;
+
+	/* The switch must not try to talk to an RTL8221B on the SerDes. */
+	ret = regmap_update_bits(priv->map, RTL8372_SDS_MODE_SEL_REG,
+				 RTL8372_SDS_CFG_MAC3_8221B |
+					 RTL8372_SDS_CFG_MAC8_8221B, 0);
+	if (ret)
+		return ret;
+
+	/* Power down the RTL8224 channels before reconfiguring the MACs.  A
+	 * board without the internal PHY (or with it held in reset) must not
+	 * make the whole switch fail to probe.
+	 */
+	ret = rtl8372_phy_write_raw(priv, 0xf0, 31, 0xa610, 0x2858);
+	if (ret)
+		dev_warn(priv->dev, "failed to power down internal PHYs: %d\n",
+			 ret);
+
+	ret = regmap_update_bits(priv->map, RTL8372_MAC_L2_GLOBAL_CTRL0_REG,
+				 RTL8372_FWD_INVLD_MAC_CTRL_EN |
+					 RTL8372_FWD_UNKN_OPCODE_EN,
+				 RTL8372_FWD_INVLD_MAC_CTRL_EN |
+					 RTL8372_FWD_UNKN_OPCODE_EN);
+	if (ret)
+		return ret;
+
+	for (port = RTL8372_FIRST_MAC_PORT;
+	     port <= RTL8372_LAST_MAC_PORT; port++) {
+		ret = regmap_update_bits(priv->map,
+					 RTL8372_MAC_L2_PORT_CTRL_REG(port),
+					 RTL8372_PORT_RX_CHK_CRC_EN |
+						 RTL8372_PORT_CLOCK_SWITCH,
+					 RTL8372_PORT_RX_CHK_CRC_EN |
+						 RTL8372_PORT_CLOCK_SWITCH);
+		if (ret)
+			return ret;
+	}
+
+	ret = regmap_update_bits(priv->map, RTL8372_RS_LAYER_CONFIG_REG,
+				 RTL8372_RS_LINK_FAULT_INDI_OFF,
+				 RTL8372_RS_LINK_FAULT_INDI_OFF);
+	if (ret)
+		return ret;
+
+	for (port = 0; port < RTL8372_NUM_PORTS + 1; port++) {
+		ret = regmap_write(priv->map,
+				   RTL8372_FC_PORT_ACT_CTRL_REG(port), 0x1050);
+		if (ret)
+			return ret;
+	}
+
+	ret = regmap_update_bits(priv->map, RTL8372_DW8051_CFG_REG,
+				 RTL8372_DW8051_READY, RTL8372_DW8051_READY);
+	if (ret)
+		return ret;
+
+	msleep(100);
+
+	/* Power the RTL8224 channels back up. */
+	ret = rtl8372_phy_write_raw(priv, 0xf0, 31, 0xa610, 0x2058);
+	if (ret)
+		dev_warn(priv->dev, "failed to power up internal PHYs: %d\n",
+			 ret);
+
+	/* Poll the status of all MAC ports (3..8, value 0x1f8). */
+	ret = regmap_update_bits(priv->map, RTL8372_SMI_GLB_CTRL_REG,
+				 RTL8372_SMI_POLLING_MASK,
+				 FIELD_PREP(RTL8372_SMI_POLLING_MASK, 0x1f8));
+	if (ret)
+		return ret;
+
+	mb->cpu_port = -1;
+
+	return 0;
+}
+
+static int rtl8372_cpu_config(struct realtek_priv *priv)
+{
+	struct rtl8372 *mb = priv->chip_data;
+	u32 mask = BIT(mb->cpu_port);
+	int ret;
+
+	ret = regmap_update_bits(priv->map, RTL8372_EXT_CPU_CTRL_REG,
+				 RTL8372_EXT_CPU_PORT,
+				 FIELD_PREP(RTL8372_EXT_CPU_PORT,
+					    mb->cpu_port));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8372_CPU_TAG_AWARE_REG,
+				 RTL8372_CPU_TAG_AWARE_MASK, mask);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->map, RTL8372_CPU_TAG_TPID_REG, ETH_P_REALTEK);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(priv->map, RTL8372_CPU_TAG_CTRL_REG,
+				  RTL8372_INT_CPUTAG_EN |
+					  RTL8372_EXT_CPUTAG_EN |
+					  RTL8372_INT_CPUTAG_INSERT |
+					  RTL8372_EXT_CPUTAG_INSERT,
+				  RTL8372_EXT_CPUTAG_EN |
+					  FIELD_PREP(RTL8372_EXT_CPUTAG_INSERT,
+						     RTL8372_CPU_INSERT_TO_ALL));
+}
+
+static int rtl8372_port_set_isolation(struct realtek_priv *priv, int port,
+				      u32 mask)
+{
+	return regmap_write(priv->map, RTL8372_PORT_ISOLATION_REG(port),
+			    FIELD_PREP(RTL8372_PORT_ISOLATION_MASK, mask));
+}
+
+static int rtl8372_port_add_isolation(struct realtek_priv *priv, int port,
+				      u32 mask)
+{
+	return regmap_update_bits(priv->map,
+				  RTL8372_PORT_ISOLATION_REG(port),
+				  FIELD_PREP(RTL8372_PORT_ISOLATION_MASK,
+					     mask),
+				  FIELD_PREP(RTL8372_PORT_ISOLATION_MASK,
+					     mask));
+}
+
+static int rtl8372_port_remove_isolation(struct realtek_priv *priv, int port,
+					 u32 mask)
+{
+	return regmap_update_bits(priv->map,
+				  RTL8372_PORT_ISOLATION_REG(port),
+				  FIELD_PREP(RTL8372_PORT_ISOLATION_MASK,
+					     mask), 0);
+}
+
+static int rtl8372_port_set_efid(struct realtek_priv *priv, int port,
+				 u32 efid)
+{
+	u32 reg;
+	int ret;
+
+	reg = RTL8372_PORT_BASED_FID_REG(port);
+
+	ret = regmap_update_bits(priv->map, reg,
+				 RTL8372_PORT_BASED_FID(port),
+				 (efid & GENMASK(3, 0)) <<
+					 ((port & 7) * 4));
+	if (ret)
+		return ret;
+
+	if (efid)
+		return regmap_update_bits(priv->map,
+					  RTL8372_PORT_BASED_FID_EN_REG,
+					  BIT(port), BIT(port));
+
+	return regmap_update_bits(priv->map, RTL8372_PORT_BASED_FID_EN_REG,
+				  BIT(port), 0);
+}
+
+static int rtl8372_port_set_learning(struct realtek_priv *priv, int port,
+				     bool enable)
+{
+	return regmap_write(priv->map, RTL8372_L2_LEARN_LIMIT_REG(port),
+			    enable ? RTL8372_MAX_LEARN_LIMIT : 0);
+}
+
+static int rtl8372_port_set_flood(struct realtek_priv *priv, u32 reg,
+				  int port, bool enable)
+{
+	return regmap_update_bits(priv->map, reg,
+				  FIELD_PREP(RTL8372_FLOOD_MASK, BIT(port)),
+				  FIELD_PREP(RTL8372_FLOOD_MASK,
+					     enable ? BIT(port) : 0));
+}
+
+static int rtl8372_port_set_ucast_flood(struct realtek_priv *priv, int port,
+					bool enable)
+{
+	return rtl8372_port_set_flood(priv, RTL8372_L2_UNKN_UC_FLOOD_REG,
+				      port, enable);
+}
