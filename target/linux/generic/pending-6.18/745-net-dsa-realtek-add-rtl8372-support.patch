+	RTL8372_SERDES_10GUSXG = 0x0d,
+	RTL8372_SERDES_HSG = 0x12,
+	RTL8372_SERDES_2500BASEX = 0x16,
+	RTL8372_SERDES_10GR = 0x1a,
+	RTL8372_SERDES_OFF = 0x1f,
+	RTL8372_SERDES_SG = 0x02,
+	RTL8372_SERDES_1000BASEX = 0x04,
+};
