+static int rtl8372_port_set_mcast_flood(struct realtek_priv *priv, int port,
+					bool enable)
+{
+	return rtl8372_port_set_flood(priv, RTL8372_L2_UNKN_MC_FLOOD_REG,
+				      port, enable);
+}
+
+static int rtl8372_port_set_bcast_flood(struct realtek_priv *priv, int port,
+					bool enable)
+{
+	return rtl8372_port_set_flood(priv, RTL8372_L2_BC_FLOOD_REG, port,
+				      enable);
+}
