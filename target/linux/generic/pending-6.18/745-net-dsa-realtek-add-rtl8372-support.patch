+static int rtl8372_speed_encoding(int speed)
+{
+	switch (speed) {
+	case SPEED_10:
+		return RTL8372_SPEED_10M;
+	case SPEED_100:
+		return RTL8372_SPEED_100M;
+	case SPEED_1000:
+		return RTL8372_SPEED_1000M;
+	case SPEED_2500:
+		return RTL8372_SPEED_2500M;
+	case SPEED_5000:
+		return RTL8372_SPEED_5G;
+	case SPEED_10000:
+		return RTL8372_SPEED_10G;
+	default:
+		return RTL8372_SPEED_1000M;
+	}
+}
+
+static int rtl8372_l2_wait(struct realtek_priv *priv)
+{
+	u32 val;
+
+	return regmap_read_poll_timeout(priv->map, RTL8372_ITA_CTRL0_REG,
+					val, !(val & RTL8372_ITA_EXECUTE),
+					10, 100000);
+}
+
+struct rtl8372_l2_entry {
+	u8 mac[ETH_ALEN];
+	u16 fid;
+	u8 port;
+	u8 age;
+	bool is_static;
+	u16 address;
+};
+
+static void rtl8372_l2_encode(const struct rtl8372_l2_entry *entry, u32 *words)
+{
+	words[0] = entry->mac[5] | (entry->mac[4] << 8) |
+		   (entry->mac[3] << 16) | (entry->mac[2] << 24);
+	words[1] = entry->mac[1] | (entry->mac[0] << 8) |
+		   ((entry->fid & GENMASK(11, 0)) << 16) |
+		   ((entry->port & GENMASK(1, 0)) << 30);
+	words[2] = ((entry->port >> 2) & GENMASK(7, 0)) |
+		   ((entry->age & GENMASK(2, 0)) << 2) |
+		   (entry->is_static ? BIT(16) : 0);
+}
+
+static void rtl8372_l2_decode(const u32 *words, struct rtl8372_l2_entry *entry)
+{
+	entry->mac[5] = words[0] & GENMASK(7, 0);
+	entry->mac[4] = (words[0] >> 8) & GENMASK(7, 0);
+	entry->mac[3] = (words[0] >> 16) & GENMASK(7, 0);
+	entry->mac[2] = (words[0] >> 24) & GENMASK(7, 0);
+	entry->mac[1] = words[1] & GENMASK(7, 0);
+	entry->mac[0] = (words[1] >> 8) & GENMASK(7, 0);
+	entry->fid = (words[1] >> 16) & GENMASK(11, 0);
+	entry->port = ((words[1] >> 30) & GENMASK(1, 0)) |
+		      ((words[2] & GENMASK(1, 0)) << 2);
+	entry->age = (words[2] >> 2) & GENMASK(2, 0);
+	entry->is_static = !!(words[2] & BIT(16));
+}
+
+static int rtl8372_l2_read_data(struct realtek_priv *priv, u32 *words)
+{
+	u32 val;
+	int i, ret;
+
+	for (i = 0; i < 3; i++) {
+		ret = regmap_read(priv->map, RTL8372_ITA_READ_DATA_REG(i),
+				  &val);
+		if (ret)
+			return ret;
+		words[i] = val;
+	}
+
+	return 0;
+}
+
+static int rtl8372_l2_write_data(struct realtek_priv *priv, const u32 *words)
+{
+	int i, ret;
+
+	for (i = 0; i < 3; i++) {
+		ret = regmap_write(priv->map, RTL8372_ITA_WRITE_DATA_REG(i),
+				   words[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int rtl8372_l2_exec(struct realtek_priv *priv, u32 ctrl)
+{
+	int ret;
+
+	ret = regmap_write(priv->map, RTL8372_ITA_CTRL0_REG, ctrl);
+	if (ret)
+		return ret;
+
+	return rtl8372_l2_wait(priv);
+}
+
+static int rtl8372_l2_lookup(struct realtek_priv *priv, const u8 *mac,
+			     u16 fid, u16 *address, u32 *words)
+{
+	struct rtl8372_l2_entry entry = {
+		.fid = fid,
+		.port = 0,
+		.age = 0,
+		.is_static = false,
+	};
+	u32 key[3], ctrl;
+	int ret;
+
+	memcpy(entry.mac, mac, ETH_ALEN);
+	rtl8372_l2_encode(&entry, key);
+
+	ret = rtl8372_l2_write_data(priv, key);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->map, RTL8372_ITA_L2_CTRL_REG,
+			   FIELD_PREP(RTL8372_ITA_L2_READ_MTHD,
+				      RTL8372_L2_READ_MAC));
+	if (ret)
+		return ret;
+
+	ret = rtl8372_l2_exec(priv, RTL8372_ITA_EXECUTE |
+			      FIELD_PREP(RTL8372_ITA_TBL_TYPE,
+					 RTL8372_ITA_TBL_L2));
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->map, RTL8372_ITA_L2_CTRL_REG, &ctrl);
+	if (ret)
+		return ret;
+
+	if (!(ctrl & RTL8372_ITA_L2_ACT_STS))
+		return -ENOENT;
+
+	if (address)
+		*address = FIELD_GET(RTL8372_ITA_L2_ADDR, ctrl);
+
+	if (words)
+		return rtl8372_l2_read_data(priv, words);
+
+	return 0;
+}
+
+static int rtl8372_l2_write(struct realtek_priv *priv,
+			    const struct rtl8372_l2_entry *entry)
+{
+	u32 words[3], ctrl;
+	int ret;
+
+	rtl8372_l2_encode(entry, words);
+
+	ret = rtl8372_l2_write_data(priv, words);
+	if (ret)
+		return ret;
+
+	ret = rtl8372_l2_exec(priv, RTL8372_ITA_EXECUTE |
+			      RTL8372_ITA_ACTION |
+			      FIELD_PREP(RTL8372_ITA_TBL_TYPE,
+					 RTL8372_ITA_TBL_L2));
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->map, RTL8372_ITA_L2_CTRL_REG, &ctrl);
+	if (ret)
+		return ret;
+
+	if (!(ctrl & RTL8372_ITA_L2_ACT_STS))
+		return -EIO;
+
+	return 0;
+}
+
+static int rtl8372_l2_clear(struct realtek_priv *priv, u16 address)
+{
+	u32 ctrl;
+	int ret;
+
+	ret = regmap_update_bits(priv->map, RTL8372_ITA_L2_CTRL_REG,
+				 RTL8372_ITA_L2_ENTRY_CLR,
+				 RTL8372_ITA_L2_ENTRY_CLR);
+	if (ret)
+		return ret;
+
+	ret = rtl8372_l2_exec(priv,
+			      FIELD_PREP(RTL8372_ITA_TBL_ADDR, address) |
+				      RTL8372_ITA_EXECUTE |
+				      RTL8372_ITA_ACTION |
+				      FIELD_PREP(RTL8372_ITA_TBL_TYPE,
+						 RTL8372_ITA_TBL_L2));
+	if (ret)
+		goto out_clear;
+
+	ret = regmap_read(priv->map, RTL8372_ITA_L2_CTRL_REG, &ctrl);
+	if (ret)
+		goto out_clear;
+
+out_clear:
+	return regmap_update_bits(priv->map, RTL8372_ITA_L2_CTRL_REG,
+				  RTL8372_ITA_L2_ENTRY_CLR, 0);
+}
+
+static int rtl8372_l2_add_uc(struct realtek_priv *priv, int port,
+			     const unsigned char addr[ETH_ALEN], u16 efid,
+			     u16 vid)
+{
+	struct rtl8372_l2_entry entry = {
+		.fid = efid,
+		.port = port,
+		.age = 6,
+		.is_static = true,
+	};
+
+	memcpy(entry.mac, addr, ETH_ALEN);
+
+	return rtl8372_l2_write(priv, &entry);
+}
+
+static int rtl8372_l2_del_uc(struct realtek_priv *priv, int port,
+			     const unsigned char addr[ETH_ALEN], u16 efid,
+			     u16 vid)
+{
+	u16 address;
+	int ret;
+
+	ret = rtl8372_l2_lookup(priv, addr, efid, &address, NULL);
+	if (ret == -ENOENT)
+		return 0;
+	if (ret)
+		return ret;
+
+	return rtl8372_l2_clear(priv, address);
+}
+
+static int rtl8372_l2_get_next_uc(struct realtek_priv *priv, u16 *addr,
+				  int port, struct realtek_fdb_entry *result)
+{
+	struct rtl8372_l2_entry entry;
+	u32 ctrl, words[3];
+	u16 address;
+	int ret;
+
+	ret = regmap_write(priv->map, RTL8372_ITA_L2_CTRL_REG,
+			   FIELD_PREP(RTL8372_ITA_L2_READ_MTHD,
+				      RTL8372_L2_READ_NEXT_L2UCSPA) |
+				   FIELD_PREP(RTL8372_ITA_L2_PORT, port));
+	if (ret)
+		return ret;
+
+	ret = rtl8372_l2_exec(priv,
+			      FIELD_PREP(RTL8372_ITA_TBL_ADDR, *addr) |
+				      RTL8372_ITA_EXECUTE |
+				      FIELD_PREP(RTL8372_ITA_TBL_TYPE,
+						 RTL8372_ITA_TBL_L2));
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->map, RTL8372_ITA_L2_CTRL_REG, &ctrl);
+	if (ret)
+		return ret;
+
+	if (!(ctrl & RTL8372_ITA_L2_ACT_STS))
+		return -ENOENT;
+
+	address = FIELD_GET(RTL8372_ITA_L2_ADDR, ctrl);
+	if (address < *addr)
+		return -ENOENT;
+
+	ret = rtl8372_l2_read_data(priv, words);
+	if (ret)
+		return ret;
+
+	rtl8372_l2_decode(words, &entry);
+	if (entry.port != port)
+		return -ENOENT;
+
+	memcpy(result->mac_addr, entry.mac, ETH_ALEN);
+	result->vid = 0;
+	result->is_static = entry.is_static;
+	*addr = address;
+
+	return 0;
+}
+
+static int rtl8372_l2_flush(struct realtek_priv *priv, int port, u16 vid)
+{
+	u32 mode;
+	int ret;
+
+	if (vid) {
+		mode = FIELD_PREP(RTL8372_L2_FLUSH_MODE, RTL8372_FLUSH_BY_VID);
+		ret = regmap_write(priv->map, RTL8372_L2_FLUSH_XID_REG,
+				   FIELD_PREP(RTL8372_L2_FLUSH_VID, vid));
+		if (ret)
+			return ret;
+	} else {
+		mode = FIELD_PREP(RTL8372_L2_FLUSH_MODE, RTL8372_FLUSH_BY_PORT);
+	}
+
+	ret = regmap_write(priv->map, RTL8372_L2_FLUSH_MODE_REG, mode);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->map, RTL8372_L2_FLUSH_CMD_REG,
+			   FIELD_PREP(RTL8372_L2_FLUSH_PMSK, BIT(port)));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8372_L2_FLUSH_CMD_REG,
+				 RTL8372_L2_FLUSH_ACT, RTL8372_L2_FLUSH_ACT);
+	if (ret)
+		return ret;
+
+	return regmap_read_poll_timeout(priv->map, RTL8372_L2_FLUSH_CMD_REG,
+					mode, !(mode & RTL8372_L2_FLUSH_BUSY),
+					10, 100000);
+}
+
+static int rtl8372_mac_force(struct realtek_priv *priv, int port, bool link,
+			     int speed, int duplex, bool tx_pause,
+			     bool rx_pause, bool fiber)
+{
+	u32 val = RTL8372_MAC_FORCE_EN;
+
+	if (link) {
+		val |= RTL8372_MAC_FORCE_LINK_EN;
+
+		if (duplex == DUPLEX_FULL)
+			val |= RTL8372_MAC_FORCE_DUPLEX;
+
+		val |= FIELD_PREP(RTL8372_MAC_FORCE_SPEED,
+				  rtl8372_speed_encoding(speed));
+
+		if (tx_pause)
+			val |= RTL8372_MAC_FORCE_TXPAUSE;
+		if (rx_pause)
+			val |= RTL8372_MAC_FORCE_RXPAUSE;
+		if (fiber)
+			val |= RTL8372_MAC_FORCE_MEDIA;
+	}
+
+	return regmap_update_bits(priv->map,
+				  RTL8372_MAC_FORCE_MODE_REG(port),
+				  GENMASK(10, 0), val);
+}
+
+static int rtl8372_serdes_config(struct realtek_priv *priv, int port,
+				 phy_interface_t interface)
+{
+	int sds = port == RTL8372_SDS_PORT0 ? 0 : 1;
+	int mode;
+
+	switch (interface) {
+	case PHY_INTERFACE_MODE_10GBASER:
+		mode = RTL8372_SERDES_10GR;
+		break;
+	case PHY_INTERFACE_MODE_USXGMII:
+		mode = RTL8372_SERDES_10GUSXG;
+		break;
+	case PHY_INTERFACE_MODE_2500BASEX:
+		mode = RTL8372_SERDES_2500BASEX;
+		break;
+	case PHY_INTERFACE_MODE_1000BASEX:
+		mode = RTL8372_SERDES_1000BASEX;
+		break;
+	case PHY_INTERFACE_MODE_SGMII:
+		mode = RTL8372_SERDES_SG;
+		break;
+	default:
+		dev_warn(priv->dev,
+			 "port %d: unsupported SerDes interface %s\n", port,
+			 phy_modes(interface));
+		return -EOPNOTSUPP;
+	}
+
+	return rtl8372_sds_mode_set(priv, sds, mode);
+}
+
+static int rtl8372_detect(struct realtek_priv *priv)
+{
+	struct rtl8372 *mb = priv->chip_data;
+	u32 val;
+	int id, ver;
+	size_t i;
+
+	if (regmap_read(priv->map, RTL8372_CHIP_ID_REG, &val)) {
+		dev_err(priv->dev, "failed to read chip id\n");
+		return -EIO;
+	}
+
+	id = FIELD_GET(RTL8372_CHIP_ID_MASK, val);
+
+	for (i = 0; i < ARRAY_SIZE(rtl8372_chip_infos); i++) {
+		if (rtl8372_chip_infos[i].chip_id == id) {
+			mb->chip_info = &rtl8372_chip_infos[i];
+			break;
+		}
+	}
+
+	if (!mb->chip_info) {
+		dev_err(priv->dev, "unrecognized switch (id=0x%06x)\n", id);
+		return -ENODEV;
+	}
+
+	ver = rtl8372_read_chip_version(priv);
+	if (ver < 0) {
+		dev_err(priv->dev, "failed to read chip version: %d\n", ver);
+		return ver;
+	}
+	mb->chip_ver = ver;
+
+	mb->priv = priv;
+	mb->cpu_port = -1;
+	mb->sds_mode[0] = -1;
+	mb->sds_mode[1] = -1;
+
+	dev_info(priv->dev, "found a %s switch (rev %u)\n",
+		 mb->chip_info->name, mb->chip_ver);
+
+	priv->num_ports = RTL8372_NUM_PORTS;
+
+	return 0;
+}
+
+static enum dsa_tag_protocol
+rtl8372_get_tag_protocol(struct dsa_switch *ds, int port,
+			 enum dsa_tag_protocol mprot)
+{
+	/* The RTL8372 uses the Realtek 8-byte protocol 4 CPU tag, inserted
+	 * after the source MAC address (DSA_TAG_PROTO_RTL8_4).
+	 */
+	return DSA_TAG_PROTO_RTL8_4;
+}
+
+static int rtl8372_change_tag_protocol(struct dsa_switch *ds,
+				       enum dsa_tag_protocol proto)
+{
+	if (proto != DSA_TAG_PROTO_RTL8_4)
+		return -EPROTONOSUPPORT;
+
+	return 0;
+}
+
+static int rtl8372_setup(struct dsa_switch *ds)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct rtl8372 *mb = priv->chip_data;
+	struct dsa_port *dp;
+	u32 upports_mask = 0, downports_mask = 0;
+	int ret, port;
+
+	ret = rtl8372_switch_init(priv);
+	if (ret) {
+		dev_err(priv->dev, "failed to initialize switch: %d\n", ret);
+		return ret;
+	}
+
+	dsa_switch_for_each_cpu_port(dp, ds) {
+		mb->cpu_port = dp->index;
+		break;
+	}
+
+	if (mb->cpu_port < 0) {
+		dev_err(priv->dev, "no CPU port defined\n");
+		return -EINVAL;
+	}
+
+	priv->cpu_port = mb->cpu_port;
+
+	/* Configure the SerDes used as CPU port or as an external MAC. */
+	dsa_switch_for_each_available_port(dp, ds) {
+		phy_interface_t interface;
+
+		if (dp->index != RTL8372_SDS_PORT0 &&
+		    dp->index != RTL8372_SDS_PORT1)
+			continue;
+
+		if (of_get_phy_mode(dp->dn, &interface))
+			continue;
+
+		if (interface == PHY_INTERFACE_MODE_INTERNAL ||
+		    interface == PHY_INTERFACE_MODE_NA)
+			continue;
+
+		ret = rtl8372_serdes_config(priv, dp->index, interface);
+		if (ret)
+			return ret;
+	}
+
+	dsa_switch_for_each_port(dp, ds) {
+		port = dp->index;
+
+		if (port < RTL8372_FIRST_MAC_PORT)
+			continue;
+
+		rtl8372_port_stp_state_set(ds, port, BR_STATE_DISABLED);
+
+		ret = rtl8372_port_set_isolation(priv, port, 0);
+		if (ret)
+			return ret;
+
+		ret = rtl8372_port_set_efid(priv, port, 0);
+		if (ret)
+			return ret;
+
+		ret = rtl8372_port_set_learning(priv, port, false);
+		if (ret)
+			return ret;
+
+		ret = rtl83xx_setup_port_flood_control(priv, port);
+		if (ret)
+			return ret;
+
+		ret = regmap_update_bits(priv->map,
+					 RTL8372_MAC_L2_PORT_CTRL_REG(port),
+					 RTL8372_PORT_RX_EN |
+						 RTL8372_PORT_TX_EN,
+					 RTL8372_PORT_RX_EN |
+						 RTL8372_PORT_TX_EN);
+		if (ret)
+			return ret;
+
+		if (dsa_port_is_cpu(dp))
+			upports_mask |= BIT(port);
+	}
+
+	dsa_switch_for_each_port(dp, ds) {
+		port = dp->index;
+
+		if (port < RTL8372_FIRST_MAC_PORT || dsa_port_is_cpu(dp))
+			continue;
+
+		ret = rtl8372_port_set_isolation(priv, port, upports_mask);
+		if (ret)
+			return ret;
+
+		downports_mask |= BIT(port);
+	}
+
+	dsa_switch_for_each_cpu_port(dp, ds) {
+		ret = rtl8372_port_set_isolation(priv, dp->index,
+						 downports_mask);
+		if (ret)
+			return ret;
+	}
+
+	ret = rtl8372_cpu_config(priv);
+	if (ret)
+		return ret;
+
+	ret = rtl8372_port_change_mtu(ds, mb->cpu_port, ETH_DATA_LEN);
+	if (ret)
+		return ret;
+
+	ds->assisted_learning_on_cpu_port = true;
+	ds->fdb_isolation = true;
+	ds->max_num_bridges = 15;
+
+	ret = rtl83xx_setup_user_mdio(ds);
+	if (ret) {
+		dev_err(priv->dev, "could not set up MDIO bus\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void rtl8372_teardown(struct dsa_switch *ds)
+{
+	struct realtek_priv *priv = ds->priv;
+
+	/* Stop inserting CPU tags so that the conduit does not keep receiving
+	 * tagged frames after the switch has been unregistered.
+	 */
+	regmap_update_bits(priv->map, RTL8372_CPU_TAG_CTRL_REG,
+			   RTL8372_EXT_CPUTAG_EN, 0);
+}
+
+static void rtl8372_port_stp_state_set(struct dsa_switch *ds, int port,
+				       u8 state)
+{
+	struct realtek_priv *priv = ds->priv;
+	u32 val;
+
+	switch (state) {
+	case BR_STATE_DISABLED:
+		val = 0;
+		break;
+	case BR_STATE_BLOCKING:
+	case BR_STATE_LISTENING:
+		val = 1;
+		break;
+	case BR_STATE_LEARNING:
+		val = 2;
+		break;
+	case BR_STATE_FORWARDING:
+		val = 3;
+		break;
+	default:
+		dev_err(priv->dev, "invalid STP state %u\n", state);
+		return;
+	}
+
+	regmap_update_bits(priv->map, RTL8372_MSTP_STATE_REG(0),
+			   RTL8372_MSTP_STATE(port), val << (port * 2));
+}
+
+static void rtl8372_phylink_get_caps(struct dsa_switch *ds, int port,
+				     struct phylink_config *config)
+{
+	config->mac_capabilities = MAC_SYM_PAUSE | MAC_ASYM_PAUSE |
+				   MAC_10 | MAC_100 | MAC_1000FD;
+
+	switch (port) {
+	case RTL8372_SDS_PORT0:
+	case RTL8372_SDS_PORT1:
+		__set_bit(PHY_INTERFACE_MODE_10GBASER,
+			  config->supported_interfaces);
+		__set_bit(PHY_INTERFACE_MODE_USXGMII,
+			  config->supported_interfaces);
+		__set_bit(PHY_INTERFACE_MODE_2500BASEX,
+			  config->supported_interfaces);
+		__set_bit(PHY_INTERFACE_MODE_1000BASEX,
+			  config->supported_interfaces);
+		__set_bit(PHY_INTERFACE_MODE_SGMII,
+			  config->supported_interfaces);
+		config->mac_capabilities |= MAC_10000FD | MAC_2500FD;
+		break;
+	default:
+		__set_bit(PHY_INTERFACE_MODE_INTERNAL,
+			  config->supported_interfaces);
+		__set_bit(PHY_INTERFACE_MODE_GMII,
+			  config->supported_interfaces);
+		config->mac_capabilities |= MAC_2500FD;
+		break;
+	}
+}
+
+static struct phylink_pcs *
+rtl8372_phylink_mac_select_pcs(struct phylink_config *config,
+			       phy_interface_t interface)
+{
+	return NULL;
+}
+
+static void rtl8372_phylink_mac_config(struct phylink_config *config,
+				       unsigned int mode,
+				       const struct phylink_link_state *state)
+{
+	struct dsa_port *dp = dsa_phylink_to_port(config);
+	struct realtek_priv *priv = dp->ds->priv;
+	int ret;
+
+	if (dp->index != RTL8372_SDS_PORT0 && dp->index != RTL8372_SDS_PORT1)
+		return;
+
+	if (mode != MLO_AN_FIXED && mode != MLO_AN_PHY)
+		return;
+
+	ret = rtl8372_serdes_config(priv, dp->index, state->interface);
+	if (ret)
+		dev_err(priv->dev, "failed to configure SerDes on port %d: %d\n",
+			dp->index, ret);
+}
+
+static void rtl8372_phylink_mac_link_up(struct phylink_config *config,
+					struct phy_device *phydev,
+					unsigned int mode,
+					phy_interface_t interface, int speed,
+					int duplex, bool tx_pause, bool rx_pause)
+{
+	struct dsa_port *dp = dsa_phylink_to_port(config);
+	struct realtek_priv *priv = dp->ds->priv;
+	int ret;
+
+	if (dp->index != RTL8372_SDS_PORT0 && dp->index != RTL8372_SDS_PORT1)
+		return;
+
+	ret = rtl8372_mac_force(priv, dp->index, true, speed, duplex,
+				tx_pause, rx_pause,
+				interface != PHY_INTERFACE_MODE_SGMII);
+	if (ret)
+		dev_err(priv->dev, "failed to force link on port %d: %d\n",
+			dp->index, ret);
+}
+
+static void rtl8372_phylink_mac_link_down(struct phylink_config *config,
+					  unsigned int mode,
+					  phy_interface_t interface)
+{
+	struct dsa_port *dp = dsa_phylink_to_port(config);
+	struct realtek_priv *priv = dp->ds->priv;
+	int ret;
+
+	if (dp->index != RTL8372_SDS_PORT0 && dp->index != RTL8372_SDS_PORT1)
+		return;
+
+	ret = rtl8372_mac_force(priv, dp->index, false, 0, 0, false, false,
+				false);
+	if (ret)
+		dev_err(priv->dev, "failed to force link down on port %d: %d\n",
+			dp->index, ret);
+}
+
+static int rtl8372_port_change_mtu(struct dsa_switch *ds, int port, int new_mtu)
+{
+	struct realtek_priv *priv = ds->priv;
+	u32 frame = new_mtu + VLAN_ETH_HLEN + ETH_FCS_LEN + 8;
+	int p, ret;
+
+	if (frame > RTL8372_MAX_FRAME_SIZE)
+		return -EINVAL;
+
+	for (p = RTL8372_FIRST_MAC_PORT; p <= RTL8372_LAST_MAC_PORT; p++) {
+		ret = regmap_update_bits(priv->map,
+					 RTL8372_MAC_L2_PORT_MAX_LEN_REG(p),
+					 RTL8372_MAX_LEN_1G_10G |
+						 RTL8372_MAX_LEN_10M_100M,
+					 FIELD_PREP(RTL8372_MAX_LEN_1G_10G,
+						    frame) |
+						 FIELD_PREP(RTL8372_MAX_LEN_10M_100M,
+							    frame));
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int rtl8372_port_max_mtu(struct dsa_switch *ds, int port)
+{
+	return 16000;
+}
+
+static int rtl8372_port_pre_bridge_flags(struct dsa_switch *ds, int port,
+					 struct switchdev_brport_flags flags,
+					 struct netlink_ext_ack *extack)
+{
+	if (flags.mask & ~(BR_LEARNING | BR_FLOOD | BR_MCAST_FLOOD |
+			   BR_BCAST_FLOOD))
+		return -EINVAL;
+
+	return 0;
+}
