+/* MAC force speeds */
+enum rtl8372_port_speed {
+	RTL8372_SPEED_10M = 0,
+	RTL8372_SPEED_100M = 1,
+	RTL8372_SPEED_1000M = 2,
+	RTL8372_SPEED_10G = 4,
+	RTL8372_SPEED_2500M = 5,
+	RTL8372_SPEED_5G = 6,
+};
